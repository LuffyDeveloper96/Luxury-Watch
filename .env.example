# ==============================================================================
# LUXURY WATCH — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/luxurywatch?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secret
JWT_SECRET=luxury_watch_geneva_master_jwt_secret_2026

# Single Master Administrator Authorization
AUTHORIZED_ADMIN_GMAIL=admin@luxurywatch.com

# Razorpay Payment Gateway
# Test keys begin with rzp_test_... / Live keys begin with rzp_live_...
RAZORPAY_KEY_ID=rzp_test_luxurywatch2026
RAZORPAY_KEY_SECRET=luxury_secret_test_key_9988

# Transactional Email & OTP System (Nodemailer / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="LUXURY WATCH Concierge" <concierge@luxurywatch.com>

# Cloudinary Image Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend Application Origin for CORS (e.g. https://luxury-watch.netlify.app or https://luxurywatch.in)
FRONTEND_URL=https://luxury-watch.netlify.app

# Frontend Environment Variables (Prefix with VITE_ for Vite build)
VITE_API_URL=/api
VITE_RAZORPAY_KEY_ID=rzp_test_luxurywatch2026
