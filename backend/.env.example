# ==============================================================================
# LUXURY WATCH — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Note: Do not put real secrets or credentials in this file.
# ==============================================================================

NODE_ENV=development
PORT=5000

# Database Connection (MongoDB Atlas)
MONGODB_URI=

# Authentication Secret (Minimum 32-character random string)
JWT_SECRET=

# Master Administrator Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Dispatch Service (SMTP - Order Confirmations)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="LUXURY WATCH Concierge" <concierge@luxurywatch.com>

# Cloudinary Persistent Media Storage (Required for persistent images & videos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client Application URL (Configured frontend origin)
FRONTEND_URL=https://luxurywatch2020.netlify.app
# FRONTEND_URLS=https://luxurywatch2020.netlify.app,http://localhost:5173
