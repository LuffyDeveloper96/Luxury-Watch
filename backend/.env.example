# ==============================================================================
# LUXURY WATCH — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Note: Do not put real secrets or credentials in this file.
# ==============================================================================

NODE_ENV=development
PORT=5000

# Database Connection (MongoDB Atlas)
MONGODB_URI=

# Authentication Secret
JWT_SECRET=

# Master Administrator Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email & OTP Service (SMTP)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client Application URL
FRONTEND_URL=
